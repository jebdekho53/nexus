{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "types": [],
    "rootDir": "src/ts",
    "outDir": "build/ts",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "declaration": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src/ts/**/*.ts"]
}
